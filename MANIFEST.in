include README.md
include LICENSE
include CHANGELOG.md

recursive-include shadowcrawler *.py
recursive-include shadowcrawler *.txt
recursive-include shadowcrawler *.json

# Optional: include external assets (not recommended for PyPI)
# include assets/*

# Exclude cache and compiled files
exclude *.pyc
exclude __pycache__/*
exclude shadowcrawler/__pycache__/*
